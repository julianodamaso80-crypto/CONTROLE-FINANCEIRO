DATABASE_URL=postgresql://financeiro:financeiro_dev_pass@localhost:5432/financeiro?schema=public
JWT_SECRET=troque_este_segredo_em_producao_minimo_32_caracteres
JWT_EXPIRES_IN=7d
PORT=3000
NODE_ENV=development

# CORS — lista de origens permitidas separadas por vírgula
# Em produção, coloque o domínio real: https://app.seudominio.com,https://admin.seudominio.com
CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# Evolution API (WhatsApp)
EVOLUTION_API_URL=https://n8n-evolution.aynvvy.easypanel.host
EVOLUTION_API_KEY=sua_api_key_global_aqui
EVOLUTION_INSTANCE_PREFIX=finnix_

# OpenRouter (IA)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxx
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Webhook público (ngrok em dev, domínio real em prod)
PUBLIC_WEBHOOK_URL=https://xxxx.ngrok-free.app

# === Gateway de pagamento — Kirvano (atual) ===
# Link do checkout da Kirvano pro produto mensal (R$ 19,90).
# Ex: https://pay.kirvano.com/AbC123
KIRVANO_CHECKOUT_URL_MONTHLY=https://pay.kirvano.com/seu-checkout-mensal
# Opcional: produto anual (R$ 199,90).
KIRVANO_CHECKOUT_URL_ANNUAL=
# Token configurado no webhook da Kirvano (string aleatória forte, 32+ chars).
# Painel Kirvano → Integrações → Webhooks → Token.
KIRVANO_WEBHOOK_TOKEN=troque_por_token_forte_aleatorio

# === Gateway de pagamento — Asaas (legado, só pra clientes antigos) ===
# Não usado em novos cadastros. Mantenha se você ainda tem clientes ativos lá.
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_BASE_URL=https://api.asaas.com/v3

# === WhatsApp Cloud API (Meta Graph API) ===
# Verify token usado no handshake do webhook em developers.facebook.com
# (precisa ser exatamente igual ao "Verificar token" que você colou no Meta).
WHATSAPP_CLOUD_VERIFY_TOKEN=mc_wpp_verify_2026_xK9pQ2nR8tLm
# Phone Number ID e WABA ID do número oficial (Configuração da API no painel Meta).
WHATSAPP_CLOUD_PHONE_NUMBER_ID=1193324517186677
WHATSAPP_CLOUD_WABA_ID=1626565008574570
# Token de acesso COM permissão whatsapp_business_messaging. Use o permanente
# de System User em produção (o gerado no console é temporário, expira em ~90 dias).
WHATSAPP_CLOUD_ACCESS_TOKEN=
# Versão da Graph API (opcional, default v21.0).
WHATSAPP_CLOUD_API_VERSION=v21.0
# App Secret (opcional) — quando setado, valida a assinatura HMAC do webhook.
WHATSAPP_CLOUD_APP_SECRET=

# === Tracking server-side (Meta CAPI + GA4 MP + Google Ads EC) ===
# Disparados no handler SALE_APPROVED do webhook Kirvano. Todos opcionais —
# se vazios, o evento server-side é pulado sem erro.
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=
GA4_MEASUREMENT_ID=G-XXXXXXXX
GA4_API_SECRET=
GOOGLE_ADS_CONVERSION_ID=AW-XXXXXXX
GOOGLE_ADS_CONVERSION_LABEL=
