generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// === Enums ===

enum CompanyPlan {
  FREE
  STARTER
  PRO
  BUSINESS
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  USER
  FINANCE
  INFLUENCER
}

// Tipo de comissão gerada por uma venda atribuída a um influencer.
// SALE = primeira venda (cliente vira pagante). RECURRING = renovações.
enum CommissionType {
  SALE
  RECURRING
}

// Estado do pagamento da comissão pro influencer.
// PENDING = devida. PAID = já repassada (PIX manual). CANCELED = estornada.
enum CommissionStatus {
  PENDING
  PAID
  CANCELED
}

enum CategoryType {
  INCOME
  EXPENSE
  BOTH
}

enum BankAccountType {
  CHECKING
  SAVINGS
  CASH
  INVESTMENT
  OTHER
}

enum TransactionType {
  INCOME
  EXPENSE
}

enum TransactionStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
}

enum TransactionSource {
  MANUAL
  WHATSAPP
  IMPORT
}

enum BudgetPeriod {
  MONTHLY
  YEARLY
}

enum InvestmentType {
  CDB
  LCI
  LCA
  TESOURO
  ACAO
  FII
  OUTRO
}

enum WhatsAppDirection {
  INBOUND
  OUTBOUND
}

enum AlertType {
  OVERDUE
  BUDGET_WARNING
  BUDGET_EXCEEDED
  WEEKLY_REPORT
  MONTHLY_REPORT
}

enum AlertChannel {
  WHATSAPP
  EMAIL
  PUSH
  NONE
}

enum WhatsAppInstanceStatus {
  PENDING_QR
  CONNECTING
  CONNECTED
  DISCONNECTED
  FAILED
}

// Por qual sistema a empresa conversa no WhatsApp.
// CLOUD = número oficial Meta (Cloud API) — padrão pra cadastros novos.
// EVOLUTION = bot Baileys/Evolution — clientes antigos (backfill).
enum WhatsAppTransport {
  EVOLUTION
  CLOUD
}

enum SubscriptionPlan {
  MONTHLY
  ANNUAL
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum CreditCardBrand {
  VISA
  MASTERCARD
  ELO
  AMEX
  HIPERCARD
  OUTRO
}

enum InvoiceStatus {
  OPEN
  CLOSED
  PAID
  OVERDUE
}

enum GoalStatus {
  ACTIVE
  COMPLETED
  PAUSED
  CANCELED
}

// === Modelos ===

model Company {
  id             String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String
  document       String?     @unique
  email          String      @unique
  phone          String?
  plan           CompanyPlan @default(FREE)
  planExpiresAt  DateTime?   @map("plan_expires_at")
  whatsappNumber String?     @unique @map("whatsapp_number")
  whatsappTransport WhatsAppTransport @default(CLOUD) @map("whatsapp_transport")
  googleSheetId  String?     @map("google_sheet_id")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  users            User[]
  categories       Category[]
  clients          Client[]
  suppliers        Supplier[]
  bankAccounts     BankAccount[]
  segments         Segment[]
  transactions     Transaction[]
  budgets          Budget[]
  investments      Investment[]
  whatsappMessages WhatsAppMessage[]
  alerts           Alert[]
  creditCards      CreditCard[]
  goals            Goal[]
  whatsappInstance WhatsAppInstance?
  subscription     Subscription?
  utmAttribution      UtmAttribution?
  conversionEventLogs ConversionEventLog[]
  leadStatusHistory   LeadStatusHistory[]
  referral            Referral?
  commissions         Commission[]

  @@map("companies")
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  name         String
  email        String
  passwordHash String   @map("password_hash")
  phone        String   @unique
  role         UserRole @default(USER)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company           Company             @relation(fields: [companyId], references: [id])
  transactions      Transaction[]
  passwordResetCodes PasswordResetCode[]
  influencer        Influencer?

  @@unique([companyId, email])
  @@index([companyId])
  @@index([phone])
  @@map("users")
}

model PasswordResetCode {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  code      String
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_codes")
}

model Category {
  id               String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId        String       @map("company_id") @db.Uuid
  name             String
  type             CategoryType
  color            String
  icon             String
  parentCategoryId String?      @map("parent_category_id") @db.Uuid
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  company      Company       @relation(fields: [companyId], references: [id])
  parent       Category?     @relation("CategoryHierarchy", fields: [parentCategoryId], references: [id])
  children     Category[]    @relation("CategoryHierarchy")
  transactions Transaction[]
  budgets      Budget[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("categories")
}

model Client {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String
  document  String?
  email     String?
  phone     String?
  address   String?
  city      String?
  state     String?
  zipCode   String?  @map("zip_code")
  notes     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company      Company       @relation(fields: [companyId], references: [id])
  transactions Transaction[]

  @@index([companyId])
  @@index([companyId, name])
  @@map("clients")
}

model Supplier {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String
  document  String?
  email     String?
  phone     String?
  address   String?
  city      String?
  state     String?
  zipCode   String?  @map("zip_code")
  notes     String?
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  company      Company       @relation(fields: [companyId], references: [id])
  transactions Transaction[]

  @@index([companyId])
  @@index([companyId, name])
  @@map("suppliers")
}

model BankAccount {
  id             String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String          @map("company_id") @db.Uuid
  name           String
  type           BankAccountType
  bankCode       String?         @map("bank_code")
  initialBalance Decimal         @default(0) @map("initial_balance") @db.Decimal(15, 2)
  currentBalance Decimal         @default(0) @map("current_balance") @db.Decimal(15, 2)
  currency       String          @default("BRL")
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  company             Company              @relation(fields: [companyId], references: [id])
  accountTransactions AccountTransaction[]
  investments         Investment[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("bank_accounts")
}

model Segment {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  name        String
  description String?
  color       String   @default("#8DFF6B")
  icon        String   @default("tag")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("segments")
}

model Transaction {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId          String            @map("company_id") @db.Uuid
  userId             String            @map("user_id") @db.Uuid
  type               TransactionType
  amount             Decimal           @db.Decimal(15, 2)
  description        String
  date               DateTime          @db.Date
  dueDate            DateTime?         @map("due_date") @db.Date
  paymentDate        DateTime?         @map("payment_date") @db.Date
  status             TransactionStatus @default(PENDING)
  categoryId         String?           @map("category_id") @db.Uuid
  clientId           String?           @map("client_id") @db.Uuid
  supplierId         String?           @map("supplier_id") @db.Uuid
  segmentId          String?           @map("segment_id") @db.Uuid
  creditCardId       String?           @map("credit_card_id") @db.Uuid
  invoiceId          String?           @map("invoice_id") @db.Uuid
  isRefund           Boolean           @default(false) @map("is_refund")
  isRecurring        Boolean           @default(false) @map("is_recurring")
  recurrenceConfig   Json?             @map("recurrence_config")
  installmentNumber  Int?              @map("installment_number")
  totalInstallments  Int?              @map("total_installments")
  installmentGroupId String?           @map("installment_group_id") @db.Uuid
  tags               String[]
  source             TransactionSource @default(MANUAL)
  notes              String?
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")

  company             Company              @relation(fields: [companyId], references: [id])
  user                User                 @relation(fields: [userId], references: [id])
  category            Category?            @relation(fields: [categoryId], references: [id])
  client              Client?              @relation(fields: [clientId], references: [id])
  supplier            Supplier?            @relation(fields: [supplierId], references: [id])
  segment             Segment?             @relation(fields: [segmentId], references: [id], onDelete: SetNull)
  creditCard          CreditCard?          @relation(fields: [creditCardId], references: [id], onDelete: SetNull)
  invoice             Invoice?             @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  accountTransactions AccountTransaction[]

  @@index([companyId])
  @@index([companyId, status, date])
  @@index([companyId, type, status])
  @@index([companyId, dueDate])
  @@index([companyId, segmentId])
  @@index([companyId, creditCardId])
  @@index([invoiceId])
  @@index([installmentGroupId])
  @@map("transactions")
}

model CreditCard {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String          @map("company_id") @db.Uuid
  name            String
  brand           CreditCardBrand @default(OUTRO)
  lastDigits      String?         @map("last_digits") @db.VarChar(4)
  creditLimit     Decimal         @default(0) @map("credit_limit") @db.Decimal(15, 2)
  closingDay      Int             @map("closing_day")
  dueDay          Int             @map("due_day")
  color           String          @default("#0EA5E9")
  isActive        Boolean         @default(true) @map("is_active")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  invoices     Invoice[]
  transactions Transaction[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("credit_cards")
}

model Invoice {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    String        @map("company_id") @db.Uuid
  creditCardId String        @map("credit_card_id") @db.Uuid
  referenceMonth Int         @map("reference_month")
  referenceYear  Int         @map("reference_year")
  closingDate  DateTime      @map("closing_date") @db.Date
  dueDate      DateTime      @map("due_date") @db.Date
  totalAmount  Decimal       @default(0) @map("total_amount") @db.Decimal(15, 2)
  paidAmount   Decimal       @default(0) @map("paid_amount") @db.Decimal(15, 2)
  status       InvoiceStatus @default(OPEN)
  paidAt       DateTime?     @map("paid_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  creditCard   CreditCard    @relation(fields: [creditCardId], references: [id], onDelete: Cascade)
  transactions Transaction[]

  @@unique([creditCardId, referenceYear, referenceMonth])
  @@index([companyId])
  @@index([creditCardId, status])
  @@map("invoices")
}

model Goal {
  id            String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     String     @map("company_id") @db.Uuid
  name          String
  description   String?
  targetAmount  Decimal    @map("target_amount") @db.Decimal(15, 2)
  currentAmount Decimal    @default(0) @map("current_amount") @db.Decimal(15, 2)
  targetDate    DateTime?  @map("target_date") @db.Date
  status        GoalStatus @default(ACTIVE)
  color         String     @default("#22C55E")
  icon          String     @default("target")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  company       Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contributions GoalContribution[]

  @@index([companyId])
  @@index([companyId, status])
  @@map("goals")
}

model GoalContribution {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  goalId    String   @map("goal_id") @db.Uuid
  amount    Decimal  @db.Decimal(15, 2)
  date      DateTime @db.Date
  notes     String?
  createdAt DateTime @default(now()) @map("created_at")

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId])
  @@map("goal_contributions")
}

model AccountTransaction {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  transactionId String   @map("transaction_id") @db.Uuid
  accountId     String   @map("account_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  transaction Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  bankAccount BankAccount @relation(fields: [accountId], references: [id])

  @@unique([transactionId, accountId])
  @@map("account_transactions")
}

model Budget {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String       @map("company_id") @db.Uuid
  categoryId     String       @map("category_id") @db.Uuid
  amount         Decimal      @db.Decimal(15, 2)
  period         BudgetPeriod
  startDate      DateTime     @map("start_date") @db.Date
  endDate        DateTime     @map("end_date") @db.Date
  alertThreshold Int          @default(80) @map("alert_threshold")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  company  Company  @relation(fields: [companyId], references: [id])
  category Category @relation(fields: [categoryId], references: [id])

  @@index([companyId])
  @@index([companyId, categoryId])
  @@map("budgets")
}

model Investment {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String         @map("company_id") @db.Uuid
  name           String
  type           InvestmentType
  amountInvested Decimal        @map("amount_invested") @db.Decimal(15, 2)
  currentValue   Decimal        @map("current_value") @db.Decimal(15, 2)
  startDate      DateTime       @map("start_date") @db.Date
  maturityDate   DateTime?      @map("maturity_date") @db.Date
  bankAccountId  String?        @map("bank_account_id") @db.Uuid
  rate           Decimal?       @db.Decimal(8, 4)
  notes          String?
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  company     Company      @relation(fields: [companyId], references: [id])
  bankAccount BankAccount? @relation(fields: [bankAccountId], references: [id])

  @@index([companyId])
  @@map("investments")
}

model WhatsAppMessage {
  id                   String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId            String?           @map("company_id") @db.Uuid
  userId               String?           @map("user_id") @db.Uuid
  phoneNumber          String            @map("phone_number")
  direction            WhatsAppDirection
  messageText          String            @map("message_text")
  aiInterpretation     Json?             @map("ai_interpretation")
  actionTaken          String?           @map("action_taken")
  relatedTransactionId String?           @map("related_transaction_id") @db.Uuid
  externalMessageId    String?           @map("external_message_id")
  modelUsed            String?           @map("model_used")
  promptTokens         Int?              @map("prompt_tokens")
  completionTokens     Int?              @map("completion_tokens")
  llmCostUsd           Float?            @map("llm_cost_usd")
  createdAt            DateTime          @default(now()) @map("created_at")

  company Company? @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([phoneNumber])
  @@index([createdAt])
  @@index([externalMessageId])
  @@map("whatsapp_messages")
}

model Alert {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId         String       @map("company_id") @db.Uuid
  type              AlertType
  title             String
  message           String
  relatedEntityId   String?      @map("related_entity_id") @db.Uuid
  relatedEntityType String?      @map("related_entity_type")
  isRead            Boolean      @default(false) @map("is_read")
  sentVia           AlertChannel @default(NONE) @map("sent_via")
  sentAt            DateTime?    @map("sent_at")
  createdAt         DateTime     @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id])

  @@index([companyId])
  @@index([companyId, isRead])
  @@map("alerts")
}

model WhatsAppInstance {
  id              String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       String                 @unique @map("company_id") @db.Uuid
  instanceName    String                 @unique @map("instance_name")
  instanceToken   String?                @map("instance_token")
  status          WhatsAppInstanceStatus @default(PENDING_QR)
  qrCodeBase64    String?                @map("qr_code_base64") @db.Text
  phoneNumber     String?                @map("phone_number")
  profileName     String?                @map("profile_name")
  profilePicUrl   String?                @map("profile_pic_url") @db.Text
  lastConnectedAt DateTime?              @map("last_connected_at")
  lastError       String?                @map("last_error") @db.Text
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([instanceName])
  @@index([phoneNumber])
  @@map("whatsapp_instances")
}

model ReportGeneration {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  periodStart DateTime @map("period_start") @db.Date
  periodEnd   DateTime @map("period_end") @db.Date
  source      String   @default("PANEL") // PANEL | WHATSAPP
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([companyId, createdAt])
  @@map("report_generations")
}

model AdminAction {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminId     String   @map("admin_id") @db.Uuid
  adminName   String   @map("admin_name")
  adminEmail  String   @map("admin_email")
  action      String
  targetType  String?  @map("target_type")
  targetId    String?  @map("target_id") @db.Uuid
  targetLabel String?  @map("target_label")
  description String
  metadata    Json?
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([adminId, createdAt])
  @@index([targetId])
  @@index([createdAt])
  @@map("admin_actions")
}

model Subscription {
  id                    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId             String             @unique @map("company_id") @db.Uuid
  userId                String             @map("user_id") @db.Uuid
  plan                  SubscriptionPlan   @default(MONTHLY)
  status                SubscriptionStatus @default(TRIALING)
  provider              String             @default("kirvano")
  asaasCustomerId       String?            @map("asaas_customer_id")
  asaasSubscriptionId   String?            @map("asaas_subscription_id")
  asaasPaymentUrl       String?            @map("asaas_payment_url") @db.Text
  kirvanoCheckoutId     String?            @map("kirvano_checkout_id")
  kirvanoCustomerEmail  String?            @map("kirvano_customer_email")
  trialEndsAt           DateTime           @map("trial_ends_at")
  currentPeriodEnd      DateTime?          @map("current_period_end")
  lastPaymentAt         DateTime?          @map("last_payment_at")
  nextPaymentAt         DateTime?          @map("next_payment_at")
  lastError             String?            @map("last_error") @db.Text
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([asaasCustomerId])
  @@index([asaasSubscriptionId])
  @@index([kirvanoCheckoutId])
  @@index([provider])
  @@index([status])
  @@map("subscriptions")
}

// =========================================================
// TRACKING — atribuição de criativo + auditoria de conversões
// =========================================================

enum TrackingDestination {
  META_CAPI
  GA4_MP
  GOOGLE_ADS
}

/// Snapshot da atribuição original do lead (1 linha por company).
/// Preenchido no signup com os click IDs / UTMs persistidos no client.
/// Usado depois pra ligar a venda (subscribe / renewal) ao criativo original.
model UtmAttribution {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   String   @unique @map("company_id") @db.Uuid
  userId      String?  @map("user_id") @db.Uuid

  // Identidade pra dedup + matching ads
  eventId     String?  @map("event_id")
  externalId  String?  @map("external_id")
  gaClientId  String?  @map("ga_client_id")
  fbp         String?
  fbc         String?

  // Click IDs (ad platforms)
  gclid       String?
  fbclid      String?
  gbraid      String?
  wbraid      String?
  msclkid     String?
  ttclid      String?

  // UTMs (campaign tagging)
  utmSource   String?  @map("utm_source")
  utmMedium   String?  @map("utm_medium")
  utmCampaign String?  @map("utm_campaign")
  utmContent  String?  @map("utm_content")
  utmTerm     String?  @map("utm_term")

  // Contexto
  landingPage String?  @map("landing_page") @db.Text
  referrer    String?  @db.Text
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent") @db.Text

  createdAt   DateTime @default(now()) @map("created_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([gclid])
  @@index([fbclid])
  @@index([utmSource, utmMedium])
  @@map("utm_attribution")
}

/// Append-only log de cada evento enviado pras plataformas.
/// Permite auditar dedup, debug de falhas, comparar contagens CRM × Meta × Google.
model ConversionEventLog {
  id             String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId      String              @map("company_id") @db.Uuid
  destino        TrackingDestination
  eventName      String              @map("event_name")
  eventId        String              @map("event_id")
  payload        Json
  responseStatus Int?                @map("response_status")
  responseBody   String?             @map("response_body") @db.Text
  success        Boolean
  errorMessage   String?             @map("error_message") @db.Text
  sentAt         DateTime            @default(now()) @map("sent_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, sentAt(sort: Desc)])
  @@index([destino, success])
  @@index([eventName, sentAt(sort: Desc)])
  @@map("conversion_event_log")
}

/// Trail de transições de status do lead — útil pra debug e dashboards de funil.
model LeadStatusHistory {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  fromStatus String?  @map("from_status")
  toStatus   String   @map("to_status")
  source     String
  rawPayload Json?    @map("raw_payload")
  changedAt  DateTime @default(now()) @map("changed_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, changedAt(sort: Desc)])
  @@map("lead_status_history")
}

// =========================================================
// INFLUENCERS / AFILIADOS — programa de comissão por indicação
// =========================================================

/// Perfil do influencer (1:1 com o User que loga na área /influencer).
/// O refCode é o que vai no link de divulgação (meucaixa.ia.br/cadastro?ref=<refCode>).
/// As comissões são percentuais configurados pelo admin por influencer.
model Influencer {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                 String   @unique @map("user_id") @db.Uuid
  refCode                String   @unique @map("ref_code")
  saleCommissionPct      Decimal  @default(30) @map("sale_commission_pct") @db.Decimal(5, 2)
  recurringCommissionPct Decimal  @default(10) @map("recurring_commission_pct") @db.Decimal(5, 2)
  pixKey                 String?  @map("pix_key")
  notes                  String?
  isActive               Boolean  @default(true) @map("is_active")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  referrals   Referral[]
  commissions Commission[]

  @@index([refCode])
  @@map("influencers")
}

/// Vínculo de uma empresa (cliente) ao influencer que a indicou.
/// 1 empresa = no máximo 1 influencer (companyId único). Carimbado no signup
/// pelo ?ref ou manualmente pelo admin ao criar/editar o cliente.
model Referral {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  influencerId String   @map("influencer_id") @db.Uuid
  companyId    String   @unique @map("company_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")

  influencer Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([influencerId])
  @@map("referrals")
}

/// Cada comissão gerada por uma venda (SALE) ou renovação (RECURRING) de uma
/// empresa indicada. amount = baseAmount * percentage/100, congelado no momento
/// da geração pra não mudar se o admin alterar os % depois.
model Commission {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  influencerId String           @map("influencer_id") @db.Uuid
  companyId    String           @map("company_id") @db.Uuid
  type         CommissionType
  baseAmount   Decimal          @map("base_amount") @db.Decimal(15, 2)
  percentage   Decimal          @db.Decimal(5, 2)
  amount       Decimal          @db.Decimal(15, 2)
  status       CommissionStatus @default(PENDING)
  description  String?
  paidAt       DateTime?        @map("paid_at")
  createdAt    DateTime         @default(now()) @map("created_at")

  influencer Influencer @relation(fields: [influencerId], references: [id], onDelete: Cascade)
  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([influencerId, status])
  @@index([companyId])
  @@index([createdAt])
  @@map("commissions")
}
