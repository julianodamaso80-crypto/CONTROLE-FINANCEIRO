# ============ RUNTIME ============
NODE_ENV=production
PORT=8080
LOG_LEVEL=info
TZ=America/Sao_Paulo
COMPANY_ID=company-meucaixa
SITE_URL=https://meucaixa.store

# ============ DATABASE (Postgres MeuCaixa) ============
# Em produção: usar o mesmo Postgres do MeuCaixa (VPS Hostinger / EasyPanel)
# Em dev: usar o postgres do docker-compose (porta 5433)
DATABASE_URL=postgresql://financeiro:financeiro_dev_pass@localhost:5433/financeiro

# ============ REDIS (BullMQ) ============
REDIS_URL=redis://localhost:6380

# ============ LLM (OpenRouter — Gemini Flash) ============
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL_GENERATOR=google/gemini-2.5-flash
AI_MODEL_CLASSIFIER=google/gemini-2.5-flash

# ============ GITHUB PUBLISHER ============
GITHUB_TOKEN=github_pat_...
GITHUB_REPO=julianodamaso/CONTROLE-FINANCEIRO
GITHUB_BRANCH_BASE=main
WEBSITE_CONTENT_DIR=frontend/content/blog

# ============ WEBHOOK AUTH ============
TRIGGER_SECRET=change-me-to-32-chars-random-hex

# ============ COMPORTAMENTO ============
AUTO_PUBLISH_ENABLED=true
DAILY_ARTICLE_LIMIT=3
DAILY_ARTICLE_BONUS=1
WEEKLY_KEYWORD_LIMIT=80
WORDS_PER_ARTICLE_MIN=1300
WORDS_PER_ARTICLE_MAX=1500

# ============ GOOGLE (GSC + GA4) ============
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GSC_SITE_URL=sc-domain:meucaixa.store
GA4_PROPERTY_ID=

# ============ BING + INDEXNOW ============
BING_API_KEY=
BING_SITE_URL=https://meucaixa.store/
INDEXNOW_KEY=

# ============ DATAFORSEO ============
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
DATAFORSEO_DAILY_BUDGET_USD=2

# ============ EASYPANEL SSH (rebuild auto) ============
EASYPANEL_SSH_KEY=
EASYPANEL_HOST=root@31.97.30.227
EASYPANEL_PROJECT=meucaixa
